# Copy to .env.local (Vite auto-loads it, and it's gitignored by default)
# for local development.

# Points fetch calls at a backend other than the dev-server proxy
# (vite.config.js already proxies /v1/* to http://localhost:8000, so this
# is normally unset in local dev).
VITE_API_BASE_URL=

# --- Auth0 (real SSO for Compliance_Officer/System_Admin) ---
# From your Auth0 dashboard -> Applications -> [this app] -> Settings.
# Application type must be "Single Page Application". Add this app's
# origin (e.g. http://localhost:5173 for dev, https://<your-domain> for
# prod) to that application's Allowed Callback URLs / Allowed Logout URLs
# / Allowed Web Origins, or the redirect will fail with a mismatch error.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=

# The "Identifier" of the Auth0 API you created for this backend (Auth0
# dashboard -> Applications -> APIs). REQUIRED to get a verifiable JWT
# access token back -- omitting this makes Auth0 issue an opaque token
# this backend cannot decode, and every upload will fail with 401.
# Must exactly match app/config.py's settings.sso_auth0_audience on the
# BACKEND (they're two sides of the same value, set independently since
# one lives in a Vite build and the other in the API's own env).
VITE_AUTH0_AUDIENCE=https://api.regengine-ai.com

# LOCAL-DEV-ONLY fallback: a Bearer token used only when Auth0 isn't
# configured or you're not logged in yet. NEVER set this in a deployed
# environment -- it bakes a static Bearer token into the public JS bundle.
# Mint one locally with your own JWT_SECRET_KEY:
#
#   PYTHONPATH=. python -c "
#   from app.config import get_settings
#   from app.security.jwt import create_access_token
#   from app.security.models import Role
#   settings = get_settings()
#   token, _ = create_access_token(subject='dev@local', roles=[Role.SYSTEM_ADMIN],
#       settings=settings, signing_key=settings.jwt_secret_key, ttl_seconds=3600)
#   print(token)"
VITE_DEV_ACCESS_TOKEN=
