# Copy to .env.local (Vite auto-loads it, and it's gitignored by default)
# for local development.

# Points fetch calls at a backend other than the dev-server proxy
# (vite.config.js already proxies /v1/* to http://localhost:8000, so this
# is normally unset in local dev).
VITE_API_BASE_URL=

# DEV-ONLY stopgap: a Bearer token for the Compliance_Officer/System_Admin
# role POST /v1/circulars/parse-and-index requires. This backend has no
# self-service login for those roles by design (app/api/auth_routes.py --
# they authenticate via real enterprise SSO, SAML or OIDC, never a
# frontend-typed credential). Mint one locally with your own JWT_SECRET_KEY:
#
#   PYTHONPATH=. python -c "
#   from app.config import get_settings
#   from app.security.jwt import create_access_token
#   from app.security.models import Role
#   settings = get_settings()
#   token, _ = create_access_token(subject='dev@local', roles=[Role.SYSTEM_ADMIN],
#       settings=settings, signing_key=settings.jwt_secret_key, ttl_seconds=3600)
#   print(token)"
#
# NEVER set this in a deployed environment -- production needs a real SSO
# integration wired into this frontend, not a pasted static token.
VITE_DEV_ACCESS_TOKEN=
