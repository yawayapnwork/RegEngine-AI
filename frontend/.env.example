# Copy to .env.local (Vite auto-loads it, and it's gitignored by default)
# for local development.

# Points fetch calls at a backend other than the dev-server proxy
# (vite.config.js already proxies /v1/* to http://localhost:8000, so this
# is normally unset in local dev).
VITE_API_BASE_URL=

# --- Auth ---
# No frontend env vars are needed for login: this app authenticates
# directly against its own backend's POST /v1/auth/login
# (app/api/auth_routes.py), which issues a self-issued JWT verified via
# app/security/local_user_store.py. Accounts are provisioned by a
# System_Admin via POST /v1/auth/users -- there is no self-service signup.
