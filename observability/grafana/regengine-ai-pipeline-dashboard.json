{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping RegEngine AI's /metrics endpoint (app/main.py).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "id": null,
  "uid": "regengine-ai-pipeline",
  "title": "RegEngine AI -- Pipeline Health",
  "description": "End-to-end SEBI compliance pipeline: ingestion latency, LLM extraction/audit agent latency + hallucination detection, OPA policy evaluation, HITL queue depth, and transaction verification outcomes. Backed by app/observability/metrics.py's Prometheus registry.",
  "tags": ["regengine-ai", "sebi", "compliance", "opa", "llm"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up{job=~\".*regengine.*\"}, instance)", "refId": "instance_variable" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": ["$__all"] },
        "hide": 0,
        "refresh": 2
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "Policy approvals",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "iconColor": "green",
        "expr": "changes(hitl_review_queue_depth{queue_type=\"policy\"}[1m]) < 0",
        "titleFormat": "HITL policy queue drained (approval/rejection)"
      }
    ]
  },

  "panels": [
    { "id": 1, "type": "row", "title": "Pipeline Health -- Ingestion & OPA Evaluation", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },

    {
      "id": 10,
      "type": "timeseries",
      "title": "SEBI Circular Ingestion Latency (p50 / p95 / p99)",
      "description": "sebi_circular_ingestion_latency_seconds -- app.services.pipeline.parse_pdf_bytes, labeled by outcome (success|error).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }, "min": 0 },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(sebi_circular_ingestion_latency_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(sebi_circular_ingestion_latency_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(sebi_circular_ingestion_latency_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingestion Throughput by Outcome",
      "description": "Circulars ingested/sec, split success vs. error -- a rising error rate here means the parsing backend (Unstructured/Tika) is failing on incoming PDFs.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(sebi_circular_ingestion_latency_seconds_count{instance=~\"$instance\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "OPA Policy Evaluation Duration (p50 / p95 / p99)",
      "description": "opa_policy_evaluation_duration_seconds -- app.execution.opa_engine.OPAEngine.evaluate. This is the latency-critical hot path for high-frequency-trading checks; watch p99 against your SLO, not just the mean.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "min": 0 },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(opa_policy_evaluation_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(opa_policy_evaluation_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(opa_policy_evaluation_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.1 }] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "OPA Evaluation Outcomes",
      "description": "opa_policy_evaluation_duration_seconds_count by outcome -- a rising 'error'/'undefined' share indicates OPA connectivity issues or malformed transaction facts, not a compliance signal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "allow" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "deny" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "undefined" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(opa_policy_evaluation_duration_seconds_count{instance=~\"$instance\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "HITL Review Queue Depth",
      "description": "hitl_review_queue_depth -- pending items awaiting human action. 'transaction' = live ambiguous trades (app.execution.hitl_queue, Redis); 'policy' = compiled policies awaiting compliance-officer sign-off (app.db HITLReview, Postgres). A sustained climb means reviewers are falling behind.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true }, "min": 0 },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "hitl_review_queue_depth{instance=~\"$instance\"}", "legendFormat": "{{queue_type}}" }
      ],
      "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 25 }] }
    },

    { "id": 2, "type": "row", "title": "LLM Agent Performance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }, "collapsed": false, "panels": [] },

    {
      "id": 20,
      "type": "timeseries",
      "title": "LLM Agent Task Duration (p50 / p95 / p99)",
      "description": "llm_agent_task_duration_seconds -- app.agents.pipeline.extract_and_audit_clause, the full CrewAI extraction+audit pass on one clause, by final audit_verdict. Expect seconds, not milliseconds -- this is LLM inference time.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "min": 0 },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(llm_agent_task_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(llm_agent_task_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(llm_agent_task_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Audit Verdicts Over Time",
      "description": "llm_agent_task_duration_seconds_count by audit_verdict -- a rising needs_revision/rejected share means the Extraction Agent's output quality is degrading (drifted prompt, model change, unusual document format).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "approved" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "needs_revision" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "rejected" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (audit_verdict) (rate(llm_agent_task_duration_seconds_count{instance=~\"$instance\"}[5m]))", "legendFormat": "{{audit_verdict}}" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Hallucinations Detected (selected range)",
      "description": "llm_hallucination_detection_total -- Logic Auditor Agent findings where the Extraction Agent invented a threshold/entity not present in the source clause. Should trend toward zero; a spike after a model/prompt change is a strong regression signal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llm_hallucination_detection_total{instance=~\"$instance\"}[$__range]))" }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Hallucination Detection Rate by Finding Type",
      "description": "llm_hallucination_detection_total, rate by finding_type/severity.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (finding_type, severity) (rate(llm_hallucination_detection_total{instance=~\"$instance\"}[15m]))", "legendFormat": "{{finding_type}} ({{severity}})" }
      ]
    },

    { "id": 3, "type": "row", "title": "Transaction Verification Outcomes", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 }, "collapsed": false, "panels": [] },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Transaction Decisions Over Time",
      "description": "transaction_evaluation_total -- app.execution.evaluator.Evaluator.evaluate_transaction's final decision, by rate. allow/deny/flagged.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "allow" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "deny" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "flagged" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (decision) (rate(transaction_evaluation_total{instance=~\"$instance\"}[5m]))", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 31,
      "type": "piechart",
      "title": "Decision Breakdown (selected range)",
      "description": "Share of allow/deny/flagged over the dashboard's time range.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 43 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "allow" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "deny" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "flagged" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "values": false }, "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "sum by (decision) (increase(transaction_evaluation_total{instance=~\"$instance\"}[$__range]))", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Deny Rate",
      "description": "Share of evaluated transactions that were DENIED (a confirmed compliance violation), over the selected range.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 52 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.15 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(transaction_evaluation_total{decision=\"deny\", instance=~\"$instance\"}[$__range])) / sum(increase(transaction_evaluation_total{instance=~\"$instance\"}[$__range]))" }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Flagged Rate (HITL escalation)",
      "description": "Share of transactions that could not be automatically decided and were escalated to a human reviewer.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 52 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.02 }, { "color": "red", "value": 0.1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(transaction_evaluation_total{decision=\"flagged\", instance=~\"$instance\"}[$__range])) / sum(increase(transaction_evaluation_total{instance=~\"$instance\"}[$__range]))" }
      ]
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Total Transactions Evaluated",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 52 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"], "values": false }, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(transaction_evaluation_total{instance=~\"$instance\"}[$__range]))" }
      ]
    }
  ],

  "links": []
}
