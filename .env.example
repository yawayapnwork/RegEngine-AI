# Copy to .env and fill in secrets. Every other value has a working
# local-dev default (see app/config.py) and can be omitted.

# --- Environment: "development" | "staging" | "production". Gates a
# startup check in app/main.py -- "production" REFUSES TO BOOT if
# jwt_secret_key is still its hardcoded development default (anyone who's
# read this codebase could otherwise forge valid tokens); "staging" only
# logs a WARNING for the same condition; "development" enforces nothing.
ENVIRONMENT=development

# --- Ingestion / vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sebi_master_circulars

# --- Manual PDF uploads (S3-compatible object storage; MinIO locally via
# docker-compose.yml's minio service, Backblaze B2/Cloudflare R2/AWS S3 in
# production) --- defaults below match that MinIO service's own defaults,
# so uploads work out of the box after `docker compose up`.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_BUCKET=regengine-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=regengine
OBJECT_STORAGE_SECRET_ACCESS_KEY=changeme123

# --- Execution service ---
OPA_SERVER_URL=http://localhost:8181
REDIS_URL=redis://localhost:6379/0
WEBHOOK_HMAC_SECRET=

# --- CORS: origins the browser frontend is allowed to call this API from.
# Only matters for a split deployment (frontend and API on different
# domains, e.g. Vercel + Render) -- same-origin deployments never need
# this. JSON array of origins; defaults to ["http://localhost:5173"]
# (local dev only) in app/config.py -- every non-local frontend domain
# (a custom domain, a Vercel/Render/Netlify URL, a preview deployment)
# must be added here explicitly. There's no placeholder production URL
# to fall back on: without this set, cross-origin requests from a
# deployed frontend are silently blocked by the browser at preflight
# (nothing reaches this service to log) -- see the startup log line in
# app/main.py.
CORS_ALLOWED_ORIGINS=

# --- Compliance rule extraction (CrewAI dual-agent pipeline, Qwen via
# Hugging Face Inference) --- either env var name is honored; set one.
HUGGINGFACEHUB_API_TOKEN=
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# --- Audit ledger (PostgreSQL) ---
LEDGER_DATABASE_URL=postgresql+asyncpg://regengine_ledger_writer:changeme@localhost:5432/regengine

# --- Main schema: circulars / clauses / compiled_rules / hitl_reviews (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://regengine_app:changeme@localhost:5432/regengine

# --- Docker Compose infrastructure ---
# Read by docker-compose.yml itself (Postgres/Redis container bootstrap
# credentials), not by the app directly -- the app's own DATABASE_URL /
# LEDGER_DATABASE_URL / REDIS_URL above still point at "localhost" for
# running the service directly on the host. docker-compose.yml overrides
# those three to the in-network service hostnames (postgres/redis) and
# substitutes these same POSTGRES_*/REDIS_PASSWORD values into them, so you
# only ever set a password once.
POSTGRES_USER=regengine
POSTGRES_PASSWORD=changeme
POSTGRES_DB=regengine
REDIS_PASSWORD=changeme
# MinIO root credentials -- docker-compose.yml also substitutes these into
# OBJECT_STORAGE_ACCESS_KEY_ID/SECRET_ACCESS_KEY above for the app services,
# so (as with the Postgres/Redis credentials above) you only set these once.
MINIO_ROOT_USER=regengine
MINIO_ROOT_PASSWORD=changeme123
IMAGE_TAG=local
