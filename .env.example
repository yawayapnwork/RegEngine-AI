# Copy to .env and fill in secrets. Every other value has a working
# local-dev default (see app/config.py) and can be omitted.

# --- Environment: "development" | "staging" | "production".
# - "development": Standard local development. Does NOT grant fake MFA claims.
# - "staging": Staging environment. Refuses to boot if DEMO_MODE=true. Warns if default secrets used.
# - "production": Production environment. REFUSES TO BOOT if jwt_secret_key is default,
#   or if DEMO_MODE=true. Requires external secret manager and production auth.
ENVIRONMENT=development

# --- Demo Mode: "true" | "false".
# Isolated demo path for testing HITL review flows without external MFA infrastructure.
# - In "development": DEMO_MODE=true automatically issues step-up MFA claims (amr=["pwd","mfa"])
#   and logs loud startup warning banners.
# - In "staging" or "production": DEMO_MODE=true is STRICTLY PROHIBITED and causes a fatal crash.
# Default is false.
DEMO_MODE=false

# --- Ingestion / vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sebi_master_circulars

# --- PDF Document Storage ---
# STORAGE_BACKEND: "local" | "s3"
# - "local": Default for local dev and POC. Stores uploaded PDFs on the local filesystem
#   under STORAGE_LOCAL_DIR without requiring MinIO or cloud object storage.
# - "s3": Uses S3-compatible storage (MinIO locally via docker-compose.yml, AWS S3 / B2 / R2 in cloud).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/uploads

# Required only if STORAGE_BACKEND=s3:
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_BUCKET=regengine-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=regengine
OBJECT_STORAGE_SECRET_ACCESS_KEY=changeme123

# --- Execution service ---
OPA_SERVER_URL=http://localhost:8181
REDIS_URL=redis://localhost:6379/0
WEBHOOK_HMAC_SECRET=

# --- CORS: origins the browser frontend is allowed to call this API from.
# Only matters for a split deployment (frontend and API on different domains).
# JSON array of origins; defaults to ["http://localhost:5173"] in app/config.py.
CORS_ALLOWED_ORIGINS=

# --- Cron-triggered queue drain (POST /v1/internal/drain-queue) ---
INTERNAL_CRON_SECRET=

# --- Compliance rule extraction ---
# LLM_PROVIDER: "offline" | "huggingface" | "openai" | "anthropic"
# - "offline": Deterministic local rules, zero external API keys needed (ideal for tests and local dev).
# - "huggingface": Uses Hugging Face Inference API with Qwen2.5-72B-Instruct.
# - "openai" / "anthropic": Uses OpenAI / Anthropic models.
LLM_PROVIDER=offline
HUGGINGFACEHUB_API_TOKEN=
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Audit ledger (PostgreSQL, append-only SHA-256 hash-chained ledger) ---
LEDGER_DATABASE_URL=postgresql+asyncpg://regengine_ledger_writer:changeme@localhost:5432/regengine

# --- Main schema: circulars / clauses / compiled_rules / hitl_reviews (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://regengine_app:changeme@localhost:5432/regengine

# --- Docker Compose infrastructure ---
# Read by docker-compose.yml itself (Postgres/Redis/MinIO bootstrap credentials),
# not by the app directly. docker-compose.yml substitutes these into service env vars.
POSTGRES_USER=regengine
POSTGRES_PASSWORD=changeme
POSTGRES_DB=regengine
REDIS_PASSWORD=changeme
MINIO_ROOT_USER=regengine
MINIO_ROOT_PASSWORD=changeme123
IMAGE_TAG=local
