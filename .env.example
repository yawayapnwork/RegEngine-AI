# Copy to .env and fill in secrets. Every other value has a working
# local-dev default (see app/config.py) and can be omitted.

# --- Ingestion / vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sebi_master_circulars

# --- Execution service ---
OPA_SERVER_URL=http://localhost:8181
REDIS_URL=redis://localhost:6379/0
WEBHOOK_HMAC_SECRET=

# --- Compliance rule extraction (CrewAI dual-agent pipeline, Qwen via
# Hugging Face Inference) --- either env var name is honored; set one.
HUGGINGFACEHUB_API_TOKEN=
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# --- Audit ledger (PostgreSQL) ---
LEDGER_DATABASE_URL=postgresql+asyncpg://regengine_ledger_writer:changeme@localhost:5432/regengine

# --- Main schema: circulars / clauses / compiled_rules / hitl_reviews (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://regengine_app:changeme@localhost:5432/regengine

# --- Docker Compose infrastructure ---
# Read by docker-compose.yml itself (Postgres/Redis container bootstrap
# credentials), not by the app directly -- the app's own DATABASE_URL /
# LEDGER_DATABASE_URL / REDIS_URL above still point at "localhost" for
# running the service directly on the host. docker-compose.yml overrides
# those three to the in-network service hostnames (postgres/redis) and
# substitutes these same POSTGRES_*/REDIS_PASSWORD values into them, so you
# only ever set a password once.
POSTGRES_USER=regengine
POSTGRES_PASSWORD=changeme
POSTGRES_DB=regengine
REDIS_PASSWORD=changeme
IMAGE_TAG=local
