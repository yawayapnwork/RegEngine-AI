# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node.js (frontend/) ---
node_modules/
# frontend/dist/ is committed: vercel.json serves the built app with
# @vercel/static next to the /v1/... Python backend (no Vercel build step).
frontend/dist/*
!frontend/dist/
!frontend/dist/index.html
!frontend/dist/assets/
!frontend/dist/assets/*
*.tsbuildinfo
npm-debug.log*

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Local data / model artifacts ---
*.pdf
!tests/**/*.pdf
policy_bundle/
sftp_landing/

# --- native/ (C++ policy kernel): compiled extensions and build output ---
native/build/
*.pyd
*.obj
*.exe
*.exp
*.lib
*.ilk
*.pdb
